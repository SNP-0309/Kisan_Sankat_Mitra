# ==============================================================================
# FasalRakshak AI — Unified Monorepo .gitignore
# Covers Mobile (Expo/React Native), Backend (Node.js/Express), and ML Service (Python)
# ==============================================================================

# ------------------------------------------------------------------------------
# Secrets & Environment Variables (NEVER COMMIT)
# ------------------------------------------------------------------------------
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
*.env
backend/.env
ml-service/.env
mobile/.env

# ------------------------------------------------------------------------------
# Node.js & JavaScript Dependencies
# ------------------------------------------------------------------------------
node_modules/
backend/node_modules/
mobile/node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
package-lock.json.bak

# ------------------------------------------------------------------------------
# Python & Virtual Environments
# ------------------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
.venv/
venv/
ENV/
env/
ml-service/.venv/
ml-service/venv/
.pytest_cache/
.coverage
htmlcov/

# ------------------------------------------------------------------------------
# ML Weights, Datasets, and Uploads
# ------------------------------------------------------------------------------
*.pt
*.pth
*.onnx
*.h5
*.tflite
models/*.pt
models/*.onnx
uploads/
backend/uploads/
ml-service/uploads/
datasets/
ml-service/datasets/

# ------------------------------------------------------------------------------
# Mobile & Expo
# ------------------------------------------------------------------------------
.expo/
mobile/.expo/
web-build/
*.jks
*.p8
*.p12
*.key
*.mobileprovision
*.orig.*

# ------------------------------------------------------------------------------
# Logs & Testing
# ------------------------------------------------------------------------------
logs/
*.log
coverage/
backend/coverage/
.nyc_output/

# ------------------------------------------------------------------------------
# Operating System & Editor Artifacts
# ------------------------------------------------------------------------------
.DS_Store
Thumbs.db
Desktop.ini
.idea/
.vscode/*
!.vscode/extensions.json
*.swp
*.swo
*~
