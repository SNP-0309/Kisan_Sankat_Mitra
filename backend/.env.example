# ==============================================================================
# FasalRakshak AI — Backend Environment Configuration Example
# Copy this file to .env and adjust values for your local development environment.
# NEVER commit real credentials or .env to version control.
# ==============================================================================

# Server Network Configuration
PORT=5000
NODE_ENV=development
API_PREFIX=/api/v1

# MongoDB Connection
# For MongoDB Atlas (replace <username>, <password>, and <cluster>):
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/fasal_rakshak?retryWrites=true&w=majority
# For local MongoDB (if running locally):
# MONGODB_URI=mongodb://localhost:27017/fasal_rakshak

# JWT Authentication
JWT_SECRET=replace_this_with_a_secure_random_string_at_least_32_chars
JWT_EXPIRES_IN=7d

# Machine Learning Service (Private Microservice Interface)
ML_SERVICE_URL=http://localhost:8000
ML_SERVICE_API_KEY=fasal_rakshak_ml_internal_secret_key_change_me
ML_SERVICE_TIMEOUT_MS=10000

# AI Orchestration (LLM Provider — Gemini)
# Isolated behind backend service interface. Mobile app never sees this key.
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.0-flash

# CORS & Client Allowlist
# In development, Expo Metro typically runs on port 8081 or web port 19006
CLIENT_URL=http://localhost:8081

# Logging & Observability
LOG_LEVEL=info
