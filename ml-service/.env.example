# ==============================================================================
# FasalRakshak AI — ML Service Environment Configuration Example
# Copy this file to .env and adjust values for your local environment.
# ==============================================================================

# Server Network Configuration
HOST=0.0.0.0
PORT=8000
ENVIRONMENT=development

# Service-to-Service Security
# Must match backend ML_SERVICE_API_KEY
SERVICE_API_KEY=fasal_rakshak_ml_internal_secret_key_change_me

# Model Configuration
# When fine-tuned YOLO weights are available, set path here:
MODEL_PATH=models/yolo_tomato_v1.pt

# Fallback / Mock Inference Mode
# Set to 'true' during local development when no trained YOLO weights are present.
# Note: Mock responses are ALWAYS clearly labelled with is_mock=True and model_name="MockInferenceAdapter".
USE_MOCK_INFERENCE=true

# Image Validation Limits
MAX_IMAGE_SIZE_MB=10
ALLOWED_IMAGE_TYPES=image/jpeg,image/png,image/webp
